node_modules/
package-lock.json

# Cache Python
__pycache__/
*.pyc

# Mémoire locale de jarvis.py
memory.json

# Secrets de développement local du relais — jamais versionnés.
worker/.dev.vars
worker/node_modules/
worker/.wrangler/

# Coffre de Jarvis : la structure est versionnée, le contenu jamais.
# Le dépôt est public — briefings, mails résumés, priorités et réflexions
# sont personnels. Ils vivent sur la machine (ou dans un coffre Obsidian
# synchronisé, via JARVIS_VAULT), pas sur GitHub.
vault/raw/*
vault/wiki/*
vault/outputs/*
!vault/*/.gitkeep
vault/.obsidian/
vault/.trash/
